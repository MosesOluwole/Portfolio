{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mosesoluwole-portfolio",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Serve only on the real domains. cloudflare-worker.js redirects www to
  // the apex and http to https.
  "routes": [
    { "pattern": "mosesoluwole.com", "custom_domain": true },
    { "pattern": "www.mosesoluwole.com", "custom_domain": true }
  ],
  // No public *.workers.dev copy of the site, and no public preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
