{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mosesoluwole-portfolio",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Serve only on the real domains. cloudflare-worker.js redirects www to
  // the apex and http to https.
  "routes": [
    { "pattern": "mosesoluwole.com", "custom_domain": true },
    { "pattern": "www.mosesoluwole.com", "custom_domain": true }
  ],
  // No public *.workers.dev copy of the site, and no public preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Enquiry form: the ONLY setting needed is the RESEND_API_KEY secret
  // (dashboard → Worker → Settings → Variables and Secrets → type "Secret").
  // Recipient and sender default to site.ts; override them here if needed.
  "vars": {
    "ENQUIRY_TO_EMAIL": "oluwolemoses@gmail.com",
    "ENQUIRY_FROM_EMAIL": "Moses Oluwole Portfolio <enquiries@mosesoluwole.com>"
  },
  // Don't delete variables set in the dashboard when deploying.
  "keep_vars": true,
  "observability": { "enabled": true }
}
