# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.co.uk

# --- Enquiry form delivery (Resend) ---
# The form stays in "email me directly" mode until BOTH of these are set.
# 1. Create an account at https://resend.com and verify your sending domain.
# 2. Create an API key and paste it here.
RESEND_API_KEY=
# Address the enquiry is delivered to (your inbox).
ENQUIRY_TO_EMAIL=
# Verified sender on your Resend domain, e.g. "Portfolio <enquiries@your-domain.co.uk>"
ENQUIRY_FROM_EMAIL=

# --- Analytics (optional) ---
# Set to "vercel" to enable cookieless Vercel Web Analytics (enable it in the
# Vercel dashboard too). The privacy notice updates automatically.
NEXT_PUBLIC_ANALYTICS=

# --- Google Search Console (optional) ---
# Only needed if you verify with the HTML-tag method. DNS verification
# (recommended) needs nothing here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
